{
  "github_trending_enabled": {
    "description": "每天推送 GitHub 趋势（需同时配置目标群）",
    "type": "bool",
    "default": false
  },
  "github_trending_time": {
    "description": "GitHub 趋势推送时间（HH:MM）",
    "type": "string",
    "default": "09:00"
  },
  "github_trending_groups": {
    "description": "目标群号，逗号分隔；填 * 才表示全部群",
    "type": "string",
    "default": ""
  },
  "morning_post_enabled": {
    "description": "每天推送早安图文（需同时配置目标群）",
    "type": "bool",
    "default": false
  },
  "morning_time": {
    "description": "早安推送时间（HH:MM）",
    "type": "string",
    "default": "07:30"
  },
  "morning_groups": {
    "description": "目标群号，逗号分隔；填 * 才表示全部群",
    "type": "string",
    "default": ""
  },
  "weather_enabled": {
    "description": "每天推送天气（需同时配置目标群）",
    "type": "bool",
    "default": false
  },
  "weather_city": {
    "description": "天气城市",
    "type": "string",
    "default": "Shanghai"
  },
  "weather_time": {
    "description": "天气推送时间（HH:MM）",
    "type": "string",
    "default": "07:00"
  },
  "weather_groups": {
    "description": "目标群号，逗号分隔；填 * 才表示全部群",
    "type": "string",
    "default": ""
  }
}
